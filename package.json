{
  "name": "homedata-mcp",
  "version": "1.0.0",
  "description": "MCP server and CLI for the Homedata UK property data API: addresses and UPRNs, EPC, council tax, planning, environmental risk, schools, broadband and more.",
  "type": "module",
  "bin": {
    "homedata-mcp": "dist/server.js",
    "homedata": "dist/cli.js",
    "homedata-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/home",
    "!dist/test/home.test.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-manifest.mjs && node scripts/home-icons.mjs",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "home:http": "node dist/home/http.js",
    "vendor": "node scripts/vendor-manifest.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "homedata",
    "uk-property",
    "property-data",
    "claude",
    "cursor",
    "codex",
    "windsurf",
    "epc",
    "flood-risk",
    "planning",
    "uprn"
  ],
  "homepage": "https://homedata.co.uk/mcp",
  "bugs": {
    "url": "https://github.com/wehomemove/homedata-mcp-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wehomemove/homedata-mcp-node.git"
  },
  "license": "MIT",
  "author": "Homedata <hello@homedata.co.uk> (https://homedata.co.uk)",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@types/node": "^22.0.0",
    "mapbox-gl": "3.15.0",
    "playwright-core": "^1.56.1",
    "typescript": "^5.5.0"
  }
}
