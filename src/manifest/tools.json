    {
      "name": "risks",
      "playground_id": "risks",
      "label": "Environmental Risks",
      "method": "GET",
      "path": "/risks/{risk_type}/",
      "params": [
        {
          "name": "risk_type",
          "in": "path",
          "type": "string",
          "required": true,
          "enum": [
            "all",
            "flood",
            "radon",
            "landfill",
            "coal_mining",
            "non_coal_mining",
            "noise",
            "air_quality_today",
            "invasive_plants"
          ],
          "playground_hint": "The screening band gives you a score; the flood layers below it give you the evidence — zones, history, defences and the 2080s outlook."
        },
        {
          "name": "uprn",
          "in": "query",
          "type": "string",
          "required": false,
          "pattern": "^\\d+$",
          "playground_hint": "Property UPRN. The flood layers also accept lat+lng instead."
        },
        {
          "name": "lat",
          "in": "query",
          "type": "string",
          "required": false,
          "alternative_to_previous": true,
          "playground_hint": "Latitude (WGS84) — flood layers only"
        },
        {
          "name": "lng",
          "in": "query",
          "type": "string",
          "required": false,
          "alternative_to_previous": true,
          "paired_with": "lat",
          "playground_hint": "Longitude (WGS84) — paired with latitude"
        }
      ],
      "tokens": {
        "default": 1,
        "when": [
          {
            "param": "risk_type",
            "in": [
              "all"
            ],
            "tokens": 5
          }
        ]
      }
